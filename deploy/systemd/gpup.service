[Unit]
Description=GPUP local inference observability
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gpup
Group=gpup
StateDirectory=gpup
EnvironmentFile=-/etc/gpup/environment
ExecStart=/usr/local/bin/gpup serve --listen 127.0.0.1:7331 --db /var/lib/gpup/gpup.db
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
